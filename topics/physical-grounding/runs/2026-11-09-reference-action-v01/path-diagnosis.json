  "full_analysis_sha256": "13defd906154dbcc3cc76ddc2888a9df8ee8c4e60ac501463a446b6cb02acec0",
  "interpretation": [
    "All four matching teachers qualified a sustained lift by 11.836\u201312.056 s and achieved strict placement.",
    "Absolute development-01-goal1 qualified a lift at 18.991 s after its applied finger reference first remained below 30 mm at 17.72 s, 6.76 s later than its teacher. Absolute development-01-goal0 never crossed this closing threshold.",
    "Absolute joint RMS tracking error was 0.0140\u20130.0200 rad, versus 0.0197\u20130.0206 rad in matching teachers. Loads and references differ; this cannot establish equal actuator quality, but stalled commanded progress is not explained solely by weak target tracking.",
    "All four relative runs made critical table contact at 7.344\u20137.574 s while fingers were approximately 34.7\u201334.8 mm open. The first 50 Hz critical snapshots identify task_table contact with link7 and/or link8; TCP height was 4.54\u20137.04 mm below the matched teacher.",
    "These observations motivate a learned local pose and progress comparison. They do not prove that phase supervision, an output representation or a correction rule will solve the failures."
  ],
  "limitations": [
    "Same-time teacher anchors describe deviations; students have no recorded phase variable and cannot be assigned teacher phases as fact.",
    "Thresholds are post-hoc descriptive:0.05rad maximum-joint and10mm TCP difference sustained across five50Hz sampled points. They are not acceptance gates.",
    "Applied jaw below30mm is a one-finger reference threshold, not total jaw opening or proof of grip; contact, loading and lift are separately reported.",
    "Joint tracking compares applied reference with measured joints at the same interval end; contact constraints and controller loads differ, so this is not an actuator calibration experiment.",
    "Teacher phase labels and native truth are used only for offline diagnosis, not learner observations.",
    "Shared starts do not establish arbitrary video transfer, new-arm compatibility or physical safety."
  ],
  "native_audit_sha256": "098c3c7b8c678790cc089dbec50d5c7c874e0a54da72844e48c49222683f9d7f",
  "native_result_sha256": "597277fd6c4671a7d2791aa861beb5da896573fcbf51f8db08e30d4bc501284e",
  "physical_robot_ready": false,
  "proposed_next_experiment": {
    "claim_boundary": "No candidate or treatment was run or selected by this diagnosis; a separately registered comparison is required.",
    "fairness": "Fix training starts, example budget, correction budget and evaluation roster before fitting; distinguish any authored IK or progress scaffold from learned control. Phase labels and native contact truth may supervise training or diagnose results, but may not enter evaluation inputs.",
    "measurement": "Measure contact-free aligned approach, loaded bilateral grasp, sustained table-free lift, timing, stalls, false progress and clearance violations before extending to carry and release. Causal camera/encoder estimates can be uncertain; do not equate a predicted completion flag with independently scored contact truth.",
    "status": "proposed_not_run",
    "treatment": "A bounded short-horizon acquisition policy that explicitly predicts tool-pose/gripper subgoals and completion progress for approach, close and test lift, compared with the unchanged endpoint controller."
  },
